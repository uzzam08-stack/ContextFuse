# ContextFuse Environment Configuration
# Copy this file to .env and fill in your values

# ─── Strands Decider 2B ────────────────────────────────────────────────────────
# Ollama-hosted Strands Decider endpoint (default: local Ollama)
DECIDER_BASE_URL=http://localhost:11434
DECIDER_MODEL=strands-decider:2b

# ─── Amazon Bedrock ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Cross-region inference profile recommended for on-demand capacity
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS credentials (prefer IAM roles/profiles over explicit keys in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Amazon DynamoDB (Run persistence) ─────────────────────────────────────────
DYNAMODB_TABLE_NAME=contextfuse-runs

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
